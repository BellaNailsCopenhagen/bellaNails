# Bella Nails — environment variables.
# Copy to .env.local (git-ignored) and fill in. Keep this file secret-free.
# Mirror the same keys in your Vercel project (Preview + Production).

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bellanails.dk

# ── Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose to the client

# ── Clerk ───────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/da/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/da/sign-up

# ── Cal.com (EU instance — cal.eu / app.cal.eu / api.cal.eu) ──
NEXT_PUBLIC_CALCOM_LINK=bellanails  # Cal USERNAME only; per-service event slug is appended
CALCOM_WEBHOOK_SECRET=              # validates /api/webhooks/cal signature
CALCOM_API_KEY=                     # server-only; REQUIRED: in-app cancel + post-booking sync (also event-type sync)

# ── Cloudinary ──────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=   # if using the unsigned upload widget
CLOUDINARY_API_KEY=                     # server, for signed uploads
CLOUDINARY_API_SECRET=                  # server-only
