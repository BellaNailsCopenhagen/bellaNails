# Bella Nails — environment variables.
# Copy to .env.local (git-ignored) and fill in. Keep this file secret-free.
# Mirror the same keys in your Vercel project (Preview + Production).

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bellanails.dk

# ── Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose to the client
# Auth = Supabase Auth (Google + email OTP). No app env vars: Google OAuth,
# email OTP, and custom SMTP (smtp.zoho.eu) are configured in the Supabase
# Dashboard (Authentication).

# ── Booking ─────────────────────────────────────────────
# Booking is fully in-house (availability, create, cancel, reschedule) — no
# external scheduler, no env vars. Rules live in the `booking_settings` table.

# ── Scaleway Object Storage (media) ─────────────────────
# EU-sovereign S3-compatible storage. Absent → media features degrade to
# "not_configured"; the app still boots. Keys/secret are server-only.
SCALEWAY_ACCESS_KEY=                    # server-only
SCALEWAY_SECRET_KEY=                    # server-only
SCALEWAY_REGION=fr-par
SCALEWAY_ENDPOINT=https://s3.fr-par.scw.cloud
SCALEWAY_BUCKET=bellanails-media
NEXT_PUBLIC_SCALEWAY_PUBLIC_BASE_URL=https://bellanails-media.s3.fr-par.scw.cloud
